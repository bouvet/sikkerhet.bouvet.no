// wrangler.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sikkerhet-bouvet-no", // change to your Pages project name
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-09-26",

  // Pages doesn't inherit `vars` into environments, so they're repeated per env.
  "env": {
    "production": {
      "vars": {
        "HUGO_VERSION": "0.166.0",
        "NODE_VERSION": "26.8.2"
      }
    },
    "preview": {
      "vars": {
        "HUGO_VERSION": "0.166.0",
        "NODE_VERSION": "26.8.2"
      }
    }
  }
}
